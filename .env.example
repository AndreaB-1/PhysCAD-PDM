# Copy to .env (docker compose) or paste into Portainer's environment variables.

# Where the app is reached from your browser. https:// turns on Secure cookies and HSTS.
APP_URL=http://nas.lan:8080
# Optional: a different public base for share links (e.g. https://share.example.com)
PUBLIC_SHARE_URL=
# 64 random characters: openssl rand -hex 32. Changing it signs everyone out and breaks enrolled 2FA.
SESSION_SECRET=
DB_PASSWORD=
# Optional: only this email may create the first administrator account.
ADMIN_EMAIL=
# The NAS folder that holds the vaults (each sub-folder can become a vault).
VAULTS_PATH=/mnt/user/pdm-vaults
# true when running behind a reverse proxy (Nginx Proxy Manager, Traefik, Caddy, Cloudflare Tunnel)
TRUST_PROXY=false
PLM_PORT=8080
TZ=Europe/Rome
# PLM_IMAGE=ghcr.io/andreab-1/physcad-pdm:v0.1.0
